# Copy to ~/.config/pipkin/env and chmod 600.

# GitHub App (create one from deploy/github-app-manifest.json).
GITHUB_APP_ID=
GITHUB_APP_SLUG=pipkin
GITHUB_WEBHOOK_SECRET=
# PEM contents with literal \n line breaks, or the multi-line PEM in quotes.
GITHUB_APP_PRIVATE_KEY=

# Optional.
# PORT=4318
# PIPKIN_MODEL=gpt-6.1-sol
# PIPKIN_MIN_SCORE=80
# PIPKIN_ADMIN_PASSWORD=   # enables `eve remote connect` with user "pipkin"
# PIPKIN_DRY_RUN=1          # log reviews instead of posting them
